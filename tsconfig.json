{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "node16",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "sourceMap": false,
        "strict": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
