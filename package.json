{
    "name": "@prmvx/code-gate",
    "version": "1.1.0",
    "description": "Global code quality gate",
    "keywords": [
        "git",
        "pre-push",
        "hook",
        "lint",
        "prettier",
        "eslint",
        "typescript",
        "quality-gate",
        "cli"
    ],
    "license": "MIT",
    "bin": {
        "code-gate": "dist/cli.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "pretest": "node -e \"require('fs').rmSync('tmp',{recursive:true,force:true})\" && npm run build",
        "dev": "tsc -p tsconfig.json --watch",
        "prepublishOnly": "npm run clean && npm run build",
        "test": "node --test",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "devDependencies": {
        "@types/node": "20.14.10",
        "typescript": "7.0.2"
    },
    "directories": {
        "test": "test"
    },
    "repository": {
        "type": "git",
        "url": "git@github-personal:Parimal2607/code-gate.git"
    },
    "author": ""
}
